{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smeet666/mcp-metacritic",
  "description": "Search Metacritic films, shows and games, read scores and critic reviews. No API key.",
  "websiteUrl": "https://github.com/smeet666/mcp-metacritic#readme",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-metacritic/main/assets/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-metacritic/main/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/smeet666/mcp-metacritic",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-metacritic",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MC_USER_AGENT",
          "description": "Override the User-Agent sent to Metacritic.",
          "isRequired": false
        },
        {
          "name": "MC_MIN_INTERVAL_MS",
          "description": "Minimum milliseconds between requests. Default 1000, floor 500.",
          "isRequired": false
        },
        {
          "name": "MC_LOG_LEVEL",
          "description": "silent, error, info or debug. Default error.",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/smeet666/mcp-metacritic/releases/download/v1.1.0/mcp-metacritic-1.1.0.mcpb",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
