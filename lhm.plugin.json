    {
      "name": "get_reviews",
      "title": "Read reviews",
      "description": "Read individual reviews of a Metacritic entry, from critics or from users. Get the slug and kind from search_titles first. Filter with 'sentiment' to read only what praised or panned it, which Metacritic groups itself. Metacritic returns a fixed sample rather than the full list, so 'total_available' is usually far larger than what comes back, and there is no way to page past the sample. Critic reviews carry the publication and a link to the original article: quote them with both. Critic scores run to 100 and user scores to 10, so do not average the two together.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier from search_titles, such as 'the-matrix'."
          },
          "kind": {
            "type": "string",
            "enum": ["movie", "show", "game"],
            "description": "Which catalogue the entry belongs to. Pass it back with the slug."
          },
          "source": {
            "default": "critic",
            "description": "'critic' is the professional press, 'user' is the audience.",
            "type": "string",
            "enum": ["critic", "user"]
          },
          "sentiment": {
            "default": "all",
            "description": "Which slice to read. Metacritic groups reviews this way itself.",
            "type": "string",
            "enum": ["all", "positive", "neutral", "negative"]
          },
          "limit": {
            "default": 10,
            "description": "How many reviews to return from the sample Metacritic publishes.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "default": 0,
            "description": "How many of the sampled reviews to skip. The sample itself cannot be paged past.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["slug", "kind"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "description": "Metacritic page these reviews belong to. Cite it when an article link is missing."
          },
          "source": {
            "type": "string"
          },
          "sentiment": {
            "type": "string"
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Excerpt as published, truncated if long."
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max": {
                  "type": "number",
                  "description": "Scale for this review's score: 100 for critics, 10 for users."
                },
                "publication": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Who ran it. Name it when quoting."
                },
                "author": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Original article. Link it when quoting."
                },
                "date": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["quote", "score", "max", "publication", "author", "url", "date"],
              "additionalProperties": false
            }
          },
          "total_available": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "How many reviews Metacritic counts in total. Usually far more than it serves here."
          },
          "offset": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as 'offset' for the next page."
          },
          "notes": {
