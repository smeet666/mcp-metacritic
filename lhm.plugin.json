            "enum": ["movie", "show", "game"],
            "description": "Which catalogue the entry belongs to. Pass it back with the slug."
          },
          "sections": {
            "default": ["basic", "scores"],
            "description": "Which parts to return. Each extra section beyond the default costs a request.",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["basic", "scores", "awards", "production", "networks", "where_to_watch"]
            }
          },
          "max_chars": {
